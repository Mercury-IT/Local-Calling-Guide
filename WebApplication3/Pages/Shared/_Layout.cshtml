<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MercuryIT</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <header class="top-bar">
            <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">
                <span class="theme-icon-light">☀</span>
                <span class="theme-icon-dark">☾</span>
            </button>
        </header>

        <main role="main" class="page-content">
            @RenderBody()
        </main>

        <footer class="site-footer">
            <div class="footer-left">
                <img src="~/images/mercuryit-logo.png" alt="MercuryIT" class="footer-logo" />
                <div class="footer-brand-text">
                    <strong>MercuryIT</strong>
                    <small>Local Calling Guide</small>
                </div>
            </div>
            <div class="footer-center">
                <a href="https://www.mercuryit.ca" target="_blank" rel="noopener" class="footer-link">www.mercuryit.ca</a>
            </div>
            <div class="footer-right">
                <span class="footer-note">Accurate prefixes. Clear connections.</span>
                <span class="copyright">© <span id="copyright-year"></span> MercuryIT</span>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
